{
  "manifest_version": 3,
  "name": "NR Revibe - Google Maps Lead Extractor",
  "version": "2.0.0",
  "description": "Deep-harvest leads from Google Maps. Scrapes websites, Instagram & Facebook for emails, tech stack, and social data. Auto-syncs to Google Sheets CRM.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "NR Rvibe Lead Extractor"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://*.google.co.in/maps/*",
        "https://*.google.co.uk/maps/*",
        "https://*.google.com.au/maps/*"
      ],
      "js": ["content.js"]
    },
    {
      "matches": [
        "https://maps-extractor.vercel.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": ["content-localhost.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "extractors/website-extractor.js",
        "extractors/website-subpage-extractor.js",
        "extractors/instagram-extractor.js",
        "extractors/facebook-extractor.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
